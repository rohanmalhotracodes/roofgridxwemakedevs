# AWS deployment settings for RoofGrid.
# Do not commit real credentials or private values.

AWS_REGION=ap-south-1
STACK_NAME=roofgrid-api
SECRET_NAME=roofgrid/config
CONTACT_EMAIL=you@example.com
ALLOWED_ORIGIN=https://your-amplify-domain.amplifyapp.com

# Amazon Bedrock configuration.
AI_MODEL=openai.gpt-oss-120b-1:0
AI_DAILY_REQUEST_LIMIT=100
AI_THROTTLE_RATE=0.5
AI_THROTTLE_BURST_LIMIT=3

# Optional: AWS Amplify app ID used by aws/deploy.sh to configure the API rewrite.
AMPLIFY_APP_ID=
